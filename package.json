{
  "name": "controle-dispositivos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "compilado:empacotar": "esbuild compilar-conferencia.ts --bundle --platform=node --format=esm --packages=external --jsx=automatic --outfile=compilados/compilar.mjs --log-level=warning",
    "compilado:dev": "npm run compilado:empacotar && node --env-file=.env.local compilados/compilar.mjs",
    "compilado:producao": "npm run compilado:empacotar && node --env-file=.env.local --env-file=.env.producao compilados/compilar.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^11.5.0",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.3",
    "googleapis": "^182.0.0",
    "next": "16.3.6",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^18.0.3",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
